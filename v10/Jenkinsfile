// Pipeline complet : Build + SonarQube + Push Docker Hub + Terraform (IaC) + Kubernetes
pipeline {
    agent any

    environment {
        DOCKERHUB_REPO    = 'siakhakaba19/portfolio'
        BUILD_TAG         = "${env.BUILD_NUMBER}"
        SONAR_SCANNER     = 'C:\\Users\\Soni-info Tech\\sonar-scanner\\bin\\sonar-scanner.bat'
        SONAR_HOST_URL    = 'http://localhost:9000'
        SONAR_PROJECT_KEY = 'Portfolio-Siakha-KABA'
        KUBECONFIG        = "C:\\ProgramData\\Jenkins\\.jenkins\\.kube\\config"
        K8S_NAMESPACE     = 'default'
        TF_DIR            = "v10\\terraform"
        TF_STATE_DIR      = "C:\\ProgramData\\Jenkins\\.jenkins\\terraform-states\\portfolio"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Preparation env') {
            steps {
                // Copie le .env secret depuis l'emplacement sécurisé
                bat 'copy "C:\\secrets\\backend.env" "%WORKSPACE%\\v10\\backend\\.env"'
                // Crée le dossier de state Terraform si absent
                bat 'if not exist "%TF_STATE_DIR%" mkdir "%TF_STATE_DIR%"'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "=== Analyse de la qualite du code avec SonarQube ==="
                dir('v10') {
                    withSonarQubeEnv('SonarQube') {
                        bat '''"%SONAR_SCANNER%" ^
                            -Dsonar.projectKey=%SONAR_PROJECT_KEY% ^
                            -Dsonar.sources=backend,frontend/src ^
                            -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/build/** ^
                            -Dsonar.sourceEncoding=UTF-8'''
                    }
                }
                echo "Analyse SonarQube terminee"
            }
        }

        stage('Quality Gate') {
            steps {
                echo "=== Verification du Quality Gate SonarQube ==="
                echo "Dashboard : ${SONAR_HOST_URL}/dashboard?id=${SONAR_PROJECT_KEY}"
            }
        }

        stage('Build') {
            steps {
                echo "=== Construction des images Docker (target prod) ==="
                bat "docker build -t %DOCKERHUB_REPO%:backend-%BUILD_TAG%  -t %DOCKERHUB_REPO%:backend-latest  v10/backend  --target prod"
                bat "docker build -t %DOCKERHUB_REPO%:frontend-%BUILD_TAG% -t %DOCKERHUB_REPO%:frontend-latest v10/frontend --target prod"
            }
        }

        stage('Login Docker Hub') {
            steps {
                echo "=== Connexion a Docker Hub ==="
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    bat 'docker login -u %DOCKER_USER% -p %DOCKER_PASS%'
                }
            }
        }

        stage('Push Docker Hub') {
            steps {
                echo "=== Push des images vers Docker Hub ==="
                bat "docker push %DOCKERHUB_REPO%:backend-%BUILD_TAG%"
                bat "docker push %DOCKERHUB_REPO%:backend-latest"
                bat "docker push %DOCKERHUB_REPO%:frontend-%BUILD_TAG%"
                bat "docker push %DOCKERHUB_REPO%:frontend-latest"
                echo "Images pushees avec succes !"
                bat "docker logout"
            }
        }

        // ── TERRAFORM IaC ─────────────────────────────────────────────────────
        stage('Configure Kubernetes') {
            steps {
                echo "=== Configuration du contexte Kubernetes ==="
                bat 'kubectl config use-context docker-desktop'
                bat 'kubectl cluster-info'
                bat 'kubectl get nodes'
            }
        }

        stage('Terraform Init') {
            steps {
                echo "=== Initialisation Terraform ==="
                dir("${env.WORKSPACE}\\${env.TF_DIR}") {
                    withCredentials([
                        string(credentialsId: 'tf-admin-password-hash', variable: 'TF_VAR_admin_password_hash'),
                        string(credentialsId: 'tf-jwt-secret',           variable: 'TF_VAR_jwt_secret')
                    ]) {
                        // Reconfigure le backend avec le chemin du state persistant
                        bat """terraform init -input=false -reconfigure ^
                            -backend-config="path=%TF_STATE_DIR%\\terraform.tfstate"
                        """
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                echo "=== Plan Terraform ==="
                dir("${env.WORKSPACE}\\${env.TF_DIR}") {
                    withCredentials([
                        string(credentialsId: 'tf-admin-password-hash', variable: 'TF_VAR_admin_password_hash'),
                        string(credentialsId: 'tf-jwt-secret',           variable: 'TF_VAR_jwt_secret')
                    ]) {
                        bat """terraform plan -input=false ^
                            -var="backend_image_tag=%BUILD_TAG%" ^
                            -var="frontend_image_tag=%BUILD_TAG%" ^
                            -out=tfplan
                        """
                    }
                }
                // Archive le plan pour audit
                archiveArtifacts artifacts: "${TF_DIR}\\tfplan", allowEmptyArchive: true
            }
        }

        stage('Terraform Apply') {
            steps {
                echo "=== Application Terraform (deploiement Kubernetes) ==="
                dir("${env.WORKSPACE}\\${env.TF_DIR}") {
                    withCredentials([
                        string(credentialsId: 'tf-admin-password-hash', variable: 'TF_VAR_admin_password_hash'),
                        string(credentialsId: 'tf-jwt-secret',           variable: 'TF_VAR_jwt_secret')
                    ]) {
                        bat "terraform apply -input=false -auto-approve tfplan"
                    }
                }
                echo "Deploiement Terraform termine !"
            }
        }
        // ──────────────────────────────────────────────────────────────────────

        stage('Rollout') {
            steps {
                echo "=== Mise a jour des images (rolling update) ==="
                bat "kubectl set image deployment/backend  backend=%DOCKERHUB_REPO%:backend-%BUILD_TAG%  -n %K8S_NAMESPACE%"
                bat "kubectl set image deployment/frontend frontend=%DOCKERHUB_REPO%:frontend-%BUILD_TAG% -n %K8S_NAMESPACE%"

                echo "Attente du rollout backend..."
                bat "kubectl rollout status deployment/backend  -n %K8S_NAMESPACE% --timeout=120s"
                echo "Attente du rollout frontend..."
                bat "kubectl rollout status deployment/frontend -n %K8S_NAMESPACE% --timeout=120s"
            }
        }

        stage('Verification') {
            steps {
                echo "=== Etat du cluster ==="
                bat "kubectl get pods     -n %K8S_NAMESPACE%"
                bat "kubectl get services -n %K8S_NAMESPACE%"
                echo "=== Outputs Terraform ==="
                dir("${env.WORKSPACE}\\${env.TF_DIR}") {
                    bat "terraform output"
                }
            }
        }

    }

    post {

        success {
            echo "Pipeline reussi - Portfolio deploye via Terraform sur Kubernetes"
            script {
                def sonarUrl = "${SONAR_HOST_URL}/dashboard?id=${SONAR_PROJECT_KEY}"
                emailext(
                    subject: "SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """<h2 style="color:green;">Deploiement reussi ✅</h2>
                    <p><b>Projet :</b> ${env.JOB_NAME}</p>
                    <p><b>Build :</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Statut :</b> SUCCESS</p>
                    <p><b>IaC :</b> Terraform apply reussi</p>
                    <p><b>Lien Jenkins :</b> <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                    <p><b>Application :</b> <a href='http://localhost:30080'>http://localhost:30080</a></p>
                    <hr>
                    <h3>Analyse SonarQube :</h3>
                    <p><a href='${sonarUrl}'>${sonarUrl}</a></p>
                    <hr>
                    <h3>Images publiees sur Docker Hub :</h3>
                    <ul>
                        <li>${env.DOCKERHUB_REPO}:backend-${env.BUILD_NUMBER}</li>
                        <li>${env.DOCKERHUB_REPO}:frontend-${env.BUILD_NUMBER}</li>
                    </ul>""",
                    mimeType: 'text/html',
                    to: 'siakha.kaba94@gmail.com',
                    from: 'siakha.kaba94@gmail.com',
                    replyTo: 'siakha.kaba94@gmail.com'
                )
            }
        }

        failure {
            echo "Pipeline echoue - consulte les logs"
            script {
                dir("${env.WORKSPACE}\\${env.TF_DIR}") {
                    bat "terraform show || exit 0"
                }
            }
            bat "kubectl get pods     -n default || exit 0"
            bat "kubectl describe pods -n default || exit 0"
            bat "docker logout || exit 0"
            emailext(
                subject: "FAILURE ❌ - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """<h2 style="color:red;">Deploiement echoue ❌</h2>
                <p><b>Projet :</b> ${env.JOB_NAME}</p>
                <p><b>Build :</b> #${env.BUILD_NUMBER}</p>
                <p><b>Statut :</b> FAILURE</p>
                <p><b>Logs :</b> <a href='${env.BUILD_URL}console'>${env.BUILD_URL}console</a></p>""",
                mimeType: 'text/html',
                to: 'siakha.kaba94@gmail.com',
                from: 'siakha.kaba94@gmail.com',
                replyTo: 'siakha.kaba94@gmail.com'
            )
        }

        always {
            echo "Etat final du cluster"
            bat "kubectl get pods -n default || exit 0"
        }

    }
}
