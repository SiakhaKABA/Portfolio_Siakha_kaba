PORT=3001
MONGO_URI=mongodb://localhost:27017/portfolio

# Hash bcrypt du mot de passe admin (généré avec bcryptjs, cost=12)
# Pour générer : node -e "require('bcryptjs').hash('votre_mot_de_passe',12).then(console.log)"
ADMIN_PASSWORD_HASH=votre_hash_bcrypt_ici

# Clé secrète JWT — générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_ici
